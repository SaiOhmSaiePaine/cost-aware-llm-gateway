# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.
LOG_LEVEL=INFO

# Redis Stack (semantic cache)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
SIMILARITY_THRESHOLD=0.85

# Complexity routing (score >= threshold -> cloud)
COMPLEXITY_THRESHOLD=0.35

# Local model: Ollama (dev) or vLLM (prod), OpenAI-compatible endpoint
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2:1b

# Cloud model: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
CLOUD_MODEL=gemini-3.5-flash-lite

# Circuit breaker
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_TIMEOUT_SECONDS=60
